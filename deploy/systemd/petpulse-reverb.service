# Laravel Reverb WebSocket server for PetPulse.
#   sudo cp deploy/systemd/petpulse-reverb.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now petpulse-reverb
[Unit]
Description=PetPulse Reverb WebSocket server
After=network.target postgresql.service

[Service]
User=www-data
Group=www-data
WorkingDirectory=/var/www/petpulse
ExecStart=/usr/bin/php artisan reverb:start --host=127.0.0.1 --port=8080
Restart=always
RestartSec=3
StandardOutput=append:/var/www/petpulse/storage/logs/reverb.log
StandardError=inherit

[Install]
WantedBy=multi-user.target
