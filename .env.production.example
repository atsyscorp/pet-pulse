# PetPulse — production environment for the Docker stack (compose.yaml).
# Copy to .env on the server and fill every value marked CHANGE-ME.
# Never commit the real .env.

APP_NAME=PetPulse
APP_ENV=production
APP_KEY=                      # CHANGE-ME: docker compose run --rm app php artisan key:generate --show
APP_DEBUG=false
APP_URL=https://petpulse.example.com   # CHANGE-ME
APP_DOMAIN=petpulse.example.com        # CHANGE-ME (used by Caddy and the Vite build)
ACME_EMAIL=admin@example.com           # CHANGE-ME (Let's Encrypt notices)
APP_VERSION=latest

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stderr
LOG_LEVEL=warning

# PostgreSQL (the `db` service). DB_HOST is set by compose.yaml.
DB_CONNECTION=pgsql
DB_PORT=5432
DB_DATABASE=petpulse
DB_USERNAME=petpulse
DB_PASSWORD=                  # CHANGE-ME: openssl rand -base64 32

# Redis (the `redis` service). REDIS_HOST is set by compose.yaml.
REDIS_CLIENT=phpredis
REDIS_PORT=6379
REDIS_PASSWORD=null
SESSION_DRIVER=redis
SESSION_LIFETIME=720
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true
CACHE_STORE=redis
QUEUE_CONNECTION=redis

FILESYSTEM_DISK=local

# Real-time kárdex (Laravel Reverb). The app publishes to the `reverb` container
# (REVERB_HOST/PORT/SCHEME are set by compose.yaml); browsers connect through
# Caddy at wss://APP_DOMAIN/app/<key>, which is what the Vite build bakes in.
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=petpulse
REVERB_APP_KEY=               # CHANGE-ME: openssl rand -hex 16
REVERB_APP_SECRET=            # CHANGE-ME: openssl rand -hex 32

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@petpulse.example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
