  "narrative": {
    "northStar": "El Monitor de Signos Vitales",
    "overview": "PetPulse looks like the calm screen at the head of an ICU bed: a quiet, legible field with one living line running across it. Surfaces are sober and tonal, text is high-contrast, and the pulse trace appears as a deliberate signature (the hero backdrop sweep, the step connector, the login mark) rather than as glow on everything. The one literal instrument on the page is the monitor panel, which stays dark in both themes the way a real device does.\n\nThe system has two equal themes, light and dark, selected by an explicit three-way toggle (light, dark, system). Light is the default. The choice is stored in localStorage under petpulse-theme, wins over the operating-system preference, and an inline script sets data-theme before first paint. All colors are consumed through semantic --pp-* custom properties.\n\nDensity is moderate on the public site: generous 80 px section rhythm, ruled rows instead of card grids. Safety outranks style.",
    "keyCharacteristics": [
      "Light (default) and dark themes with a persistent manual toggle; system is one option.",
      "Depth from tonal layers and 1 px lines, not shadows.",
      "Outfit Variable throughout, self-hosted, in Latin American Spanish with full diacritics.",
      "One signature motif: the vital-signs trace, in CRT phosphor green as the hero backdrop sweep.",
      "Always-dark monitor device panel carrying real kárdex states, labelled as synthetic.",
      "Touch-first: 48 px targets, 12 to 24 px radii, status always icon plus label."
    ],
    "rules": [
      {
        "name": "The Trace-Only Cyan Rule",
        "body": "Cyan (#22e5f5) is a dark-theme action fill and trace line, never a paragraph color on a light surface; light theme uses Trace Teal.",
        "section": "colors"
      },
      {
        "name": "The Status Is Sacred Rule",
        "body": "Green, red and amber mean dose state and nothing else. No decorative use anywhere. The hero trace is CRT Phosphor, a separate token, and is not a status color.",
        "section": "colors"
      },
      {
        "name": "The Dark Device Rule",
        "body": "The monitor panel keeps its screen-* tokens in both themes. It is a device, not a surface that themes.",
        "section": "colors"
      },
      {
        "name": "The Numbers Align Rule",
        "body": "Every dose, time, stock figure and step number uses tabular numerals so columns read at a glance.",
        "section": "typography"
      },
      {
        "name": "The Flat-By-Default Rule",
        "body": "Surfaces are flat at rest. Hover and focus change tone and border, never blur or shadow.",
        "section": "elevation"
      },
      {
        "name": "The Single Glow Rule",
        "body": "The hero ECG live segment carries one soft drop-shadow(0 0 5px var(--pp-crt)). This is the sole sanctioned glow in the system, applies to that trace only, and no other element, text, button or panel glows.",
        "section": "elevation"
      }
    ],
    "openQuestions": [
      "CRT Phosphor (#6b9a2e / #a3d95b) sits close in hue to status green. The user has not decided whether to shift its hue or unify all traces on one color (steps connector and login mark are still teal). Do not extend phosphor green to new elements until resolved."
    ],
    "dos": [
      "Do default to light, offer light, dark and system, store the explicit choice under petpulse-theme, and apply it before first paint.",
      "Do consume color only through the --pp-* semantic tokens so both themes work.",
      "Do keep every interactive target at least 48 px and every text pair at WCAG AA.",
      "Do pair every status color with an icon or a word.",
      "Do keep the monitor on its always-dark screen-* tokens in both themes.",
      "Do use ruled rows and drawn specimens with labelled synthetic data to show product states.",
      "Do keep Outfit self-hosted and honor prefers-reduced-motion: the hero trace becomes a static line."
    ],
    "donts": [
      "Don't add glow to anything other than the hero ECG live trace; no neon text-shadow, blurred orbs, or box-shadow depth.",
      "Don't put Pulse Cyan text on a light surface; use Trace Teal.",
      "Don't use green, red or amber decoratively, and don't use CRT Phosphor for anything but the hero trace until the open hue question is settled.",
      "Don't animate inside the kárdex board beyond the overdue dot.",
      "Don't replace ruled feature rows with an icon-card grid.",
      "Don't invent customers, testimonials or metrics in marketing sections."
    ]
  }
}
